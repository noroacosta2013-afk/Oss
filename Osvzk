--==================================================
-- ESP 2D
--==================================================

local espObjects = {}

local function removeESP(targetPlayer)

    local data = espObjects[targetPlayer]

    if not data then
        return
    end

    if data.box then
        data.box:Destroy()
    end

    if data.line then
        data.line:Destroy()
    end

    espObjects[targetPlayer] = nil
end

local function createESP(targetPlayer)

    if targetPlayer == player then
        return
    end

    removeESP(targetPlayer)

    local box = Instance.new("Frame")

    box.Name = "BKY_ESP_BOX"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.ZIndex = 10
    box.Parent = gui

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Parent = box

    local line = Instance.new("Frame")

    line.Name = "BKY_ESP_LINE"
    line.BackgroundColor3 = Color3.new(1, 1, 1)
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Visible = false
    line.ZIndex = 9
    line.Parent = gui

    espObjects[targetPlayer] = {
        box = box,
        line = line
    }
end

local function updateESP(targetPlayer, data)

    local character = targetPlayer.Character

    if not character then
        data.box.Visible = false
        data.line.Visible = false
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    local head =
        character:FindFirstChild("Head")

    if not humanoid
    or humanoid.Health <= 0
    or not root
    or not head then

        data.box.Visible = false
        data.line.Visible = false
        return
    end

    local rootPos, rootVisible =
        camera:WorldToViewportPoint(root.Position)

    local headPos, headVisible =
        camera:WorldToViewportPoint(
            head.Position + Vector3.new(0, 0.5, 0)
        )

    if not rootVisible or not headVisible then
        data.box.Visible = false
        data.line.Visible = false
        return
    end

    --==================================================
    -- BOX MÁS PEQUEÑA
    --==================================================

    local height =
        math.abs(rootPos.Y - headPos.Y) * 2.2

    local width =
        height * 0.55

    -- 82% DEL TAMAÑO ORIGINAL
    local ESP_SCALE = 0.82

    height = height * ESP_SCALE
    width = width * ESP_SCALE

    if height < 8 then
        height = 8
    end

    if width < 5 then
        width = 5
    end

    data.box.Size =
        UDim2.fromOffset(width, height)

    data.box.Position =
        UDim2.fromOffset(
            rootPos.X - width / 2,
            headPos.Y - height * 0.15
        )

    data.box.Visible = true

    --==================================================
    -- LINE
    --==================================================

    local viewport = camera.ViewportSize

    local startX = viewport.X / 2
    local startY = viewport.Y

    local endX = rootPos.X
    local endY = rootPos.Y

    local dx = endX - startX
    local dy = endY - startY

    local length =
        math.sqrt(dx * dx + dy * dy)

    local angle =
        math.deg(math.atan2(dy, dx))

    data.line.Size =
        UDim2.fromOffset(length, 2)

    data.line.Position =
        UDim2.fromOffset(
            (startX + endX) / 2,
            (startY + endY) / 2
        )

    data.line.Rotation = angle
    data.line.Visible = true

end

