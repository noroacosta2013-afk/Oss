    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - lockDragStart

        externalLock.Position =
            UDim2.new(
                lockStartPosition.X.Scale,
                lockStartPosition.X.Offset + delta.X,

                lockStartPosition.Y.Scale,
                lockStartPosition.Y.Offset + delta.Y
            )
    end
end)

