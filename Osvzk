espButton.Activated:Connect(function()

    espEnabled = not espEnabled

    if espEnabled then

        espButton.Text = "ESP: ON"

        for _, targetPlayer in ipairs(Players:GetPlayers()) do

            if targetPlayer ~= player then
                createESP(targetPlayer)
            end

        end

    else

        espButton.Text = "ESP: OFF"

        for targetPlayer in pairs(espObjects) do
            removeESP(targetPlayer)
        end

    end
end)

--==================================================
-- JUGADORES
--==================================================

local function setupPlayer(targetPlayer)

    if targetPlayer == player then
        return
    end

    targetPlayer.CharacterAdded:Connect(function()

        if espEnabled then

            task.wait(0.2)

            if targetPlayer.Character then
                createESP(targetPlayer)
            end

        end

    end)

    targetPlayer.CharacterRemoving:Connect(function()
        removeESP(targetPlayer)
    end)

    if targetPlayer.Character and espEnabled then
        createESP(targetPlayer)
    end

end

for _, targetPlayer in ipairs(Players:GetPlayers()) do
    setupPlayer(targetPlayer)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(targetPlayer)

    removeESP(targetPlayer)

    if lockedTarget then
        lockedTarget = nil
    end

end)

--==================================================
-- BUCLE
--==================================================

RunService.RenderStepped:Connect(function()

    camera = workspace.CurrentCamera or camera

    -- FOV

    local viewport = camera.ViewportSize

    fovCircle.Position =
        UDim2.fromOffset(
            viewport.X / 2,
            viewport.Y / 2
        )

    -- LOCK

    if lockEnabled then

        if not targetAlive(lockedTarget) then
            lockedTarget = getClosestTarget()
        end

        if targetAlive(lockedTarget) then

            camera.CFrame =
                CFrame.lookAt(
                    camera.CFrame.Position,
                    lockedTarget.Position
                )

        end
    end

    -- ESP

    if espEnabled then

        for _, targetPlayer in ipairs(Players:GetPlayers()) do

            if targetPlayer ~= player then

                local data = espObjects[targetPlayer]

                if not data then

                    createESP(targetPlayer)
                    data = espObjects[targetPlayer]

                end

                if data then
                    updateESP(targetPlayer, data)
                end

            end
        end
    end

end)

